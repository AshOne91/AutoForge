# This file is local secret staging for the Docker Compose profile. Copy it to
# .env, replace every sample value, and never commit the resulting .env file.
CONTROL_PLANE_BIND_ADDRESS=127.0.0.1
CONTROL_PLANE_PORT=49700

CONTROL_DB_NAME=autoforge_control
CONTROL_DB_USER=autoforge
CONTROL_DB_PASSWORD=replace-with-a-long-random-password
AUTOFORGE_DATABASE_URL=postgresql+asyncpg://autoforge:replace-with-a-long-random-password@control-db:5432/autoforge_control
CONTROL_PLANE_API_TOKEN=replace-with-a-long-random-token
